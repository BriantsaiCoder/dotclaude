{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "DOTNET_CLI_HOME": "/Users/pochientsai/.dotnet",
    "DOTNET_SYSTEM_NET_DISABLEIPV6": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore --staged -- *)",
      "Bash(git push --force-with-lease *)",
      "Bash(dotnet dev-certs *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status)",
      "Bash(jq *)",
      "Bash(sqlite3 *)",
      "Bash(~/.claude/hooks/launchctl-readonly.sh *)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_microsoft-docs_microsoft-learn__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__shadcn__*",
      "mcp__plugin_github_github__issue_read",
      "mcp__plugin_github_github__pull_request_read",
      "mcp__plugin_github_github__get_file_contents",
      "mcp__plugin_github_github__get_me"
    ],
    "ask": [],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Edit(~/Documents/**)",
      "Edit(~/Desktop/**)",
      "Edit(~/Pictures/**)",
      "Edit(~/Movies/**)",
      "Edit(~/Music/**)",
      "Edit(~/Applications/**)",
      "Edit(~/Library/Preferences/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git restore *--source*)",
      "Bash(git reset --hard *)",
      "Bash(npm publish *)",
      "Bash(dotnet user-secrets *)",
      "Bash(launchctl *)",
      "Bash(/bin/launchctl *)",
      "Bash(env launchctl *)",
      "Bash(env /bin/launchctl *)",
      "Bash(/usr/bin/env launchctl *)",
      "Bash(/usr/bin/env /bin/launchctl *)",
      "Bash(defaults write *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "/Users/pochientsai/.agents"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/watch-ci-after-push.sh",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-git-push.sh",
            "timeout": 3,
            "async": false
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-pr-merge.sh",
            "timeout": 15,
            "async": false
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-bash.sh",
            "timeout": 3,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-cookbook-orphan.sh",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/patch-chrome-devtools-mcp.sh",
            "timeout": 3,
            "async": false
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/patch-playwright-mcp.sh",
            "timeout": 3,
            "async": false
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/drift-check.sh",
            "timeout": 10,
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-time.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "remember@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "language": "zh-TW",
  "model": "claude-opus-5",
  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.nuget.org",
        "*.nuget.org",
        "pkgs.dev.azure.com",
        "nuget.pkg.github.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "registry.hub.docker.com",
        "ghcr.io",
        "*.pkg.github.com",
        "playwright.download.prss.microsoft.com",
        "cdn.playwright.dev",
        "dotnetcli.azureedge.net",
        "download.visualstudio.microsoft.com",
        "aka.ms",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "registry.yarnpkg.com",
        "cdn.jsdelivr.net",
        "cdnjs.cloudflare.com",
        "unpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "mcr.microsoft.com",
        "nodejs.org",
        "storage.googleapis.com",
        "pkg-containers.githubusercontent.com",
        "google.com",
        "*.google.com",
        "*.gstatic.com"
      ],
      "allowUnixSockets": [
        "/Users/pochientsai/.agent-browser",
        "/Users/pochientsai/Library/Application Support/Google/Chrome for Testing",
        "/tmp/claude-501",
        "/private/tmp/claude-501"
      ],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd",
        "com.apple.trustd.agent"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/Users/pochientsai/.nuget",
        "/Users/pochientsai/.dotnet",
        "/tmp/.dotnet",
        "/private/tmp/.dotnet",
        "/Users/pochientsai/.npm",
        "/Users/pochientsai/.cache",
        "/Users/pochientsai/Library/Caches",
        "/Users/pochientsai/.agents",
        "/Users/pochientsai/.copilot",
        "/Users/pochientsai/.codex",
        "/Users/pochientsai/Downloads/coding_agent_project",
        "/Users/pochientsai/.agent-browser",
        "/Users/pochientsai/Library/Application Support/Google/Chrome for Testing",
        "/Users/pochientsai/.Trash"
      ],
      "denyWrite": [
        "~/.claude/CLAUDE.md",
        "~/.claude/settings.json",
        "~/.claude/hooks"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "agent-browser"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoCompactWindow": 1000000,
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "dotnet build/test/run/watch/restore, dotnet ef migrations add/update (not drop or remove applied migrations)",
      "npm/pnpm/yarn install/ci/run/test/build, npx <tool>, vitest, playwright test",
      "docker compose up/down/build/logs/ps, docker run/exec/logs on local containers",
      "git status/diff/log/show/add/commit/branch (no -D)/checkout <branch>/pull/fetch/stash push/push (non-force)/push --force-with-lease"
    ],
    "soft_deny": [
      "$defaults",
      "Reading or exfiltrating secret files (.env*, appsettings.*.json, *.pem/*.key/*.pfx, ~/.ssh/id_*, ~/.aws/credentials, .npmrc, .netrc) via any reader (cat/less/more/head/tail/bat/xxd/od/hexdump/base64/openssl) or piping them into network tools (curl/nc/scp/rsync).",
      "Destructive SQL through psql/mysql/mariadb/sqlcmd: DROP DATABASE/TABLE/SCHEMA, TRUNCATE, or unqualified DELETE/UPDATE.",
      "Destructive NoSQL: mongosh drop/dropDatabase, redis-cli FLUSHDB/FLUSHALL, DETACH DATABASE.",
      "Publishing to external registries: npm/yarn/pnpm publish, dotnet nuget push, cargo publish, gem push, twine upload, docker/helm push to public registries.",
      "Modifying local trust or secret stores: dotnet user-secrets set/clear, dotnet dev-certs, security add-trusted-cert, keychain writes, update-ca-certificates.",
      "Silently discarding uncommitted work: git checkout . / -- <path>, git restore . / --source, git reflog expire, git stash drop/clear.",
      "Database or migration destruction: dotnet ef database drop, ef migrations remove after apply, prisma migrate reset, knex migrate:rollback against non-ephemeral targets."
    ],
    "hard_deny": [
      "$defaults",
      "Never merge a pull request unless ~/.agents/bin/pr-review-gate reported STATE=PASS for that PR at the current head SHA in this session.",
      "Never delete, transfer, or change the visibility of a GitHub repository, and never delete releases or tags.",
      "Never write to files under the user's home directory outside the session's working directory, ~/.claude, and ~/.agents — this includes ~/Documents, ~/Desktop, ~/Pictures, ~/Library, and shell startup files. Inside ~/.claude the contents of CLAUDE.md, settings.json, and hooks/ are separately protected by Edit deny rules and sandbox denyWrite; that protection covers editing those files and nothing else. It does not extend to git bookkeeping: staging, committing, or pushing those paths writes ~/.claude/.git (index, objects, refs), never the files themselves, and is ordinary version control of the user's own repository — allowed, including when a path argument names one of the protected files."
    ],
    "environment": [
      "$defaults",
      "Repository config, manifests, lockfiles, CI, and the current task are the source of truth for package manager, database target, and credential/environment boundaries; assume neither local-only nor production access without evidence.",
      "Sandbox is enabled and autoAllowBashIfSandboxed is true — project workspace writable; package manager caches (npm, NuGet, .NET, Playwright browsers) and ~/.Trash also whitelisted via allowWrite. Unsandboxed retry stays available and is gated by the auto-mode classifier rather than a prompt, so unattended runs do not stall.",
      "Preferred stacks: .NET 8 / ASP.NET Core, EF Core, PostgreSQL, Vite + React/Vue, Tailwind, Docker Compose.",
      "~/.claude is the user's own dotfiles repository (remote: github.com/BriantsaiCoder/dotclaude, private), and ~/.agents is github.com/BriantsaiCoder/agents-config. Routine git operations in either — status, diff, add, commit, branch, push to a feature branch, pull — are ordinary maintenance of the user's own configuration, not scope escalation, even though those paths sit outside the session working directory. Writes there reach the filesystem through the unsandboxed retry path because neither directory is in allowWrite; that retry is expected for this repo pair and is not an auto-mode bypass."
    ]
  },
  "fastMode": true,
  "ultracode": true
}
